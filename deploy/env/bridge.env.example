# Rendered by the installer to .runtime/env/bridge.env (mode 600).
# Full reference: docs/configuration.md
NOTION_AGENT_HOME=/home/you/.notionagents
NOTION_BRIDGE_HOST=127.0.0.1
NOTION_BRIDGE_PORT=8765
CODE_ROOT=/home/you/projects

# Endpoint of the coding-tools MCP runtime. The installer fills in the secret
# it generated for mcp-runtime.env.
NOTION_MCP_RUNTIME_URL=http://127.0.0.1:8787/mcp/replace-with-the-runtime-secret

# Leave empty to let the client choose the model.
NOTION_FORCE_MODEL=opus-5
NOTION_LOG_LEVEL=INFO
NOTION_INFERENCE_TIMEOUT_SECONDS=180
