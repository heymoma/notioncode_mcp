# Rendered by the installer to .runtime/env/mcp-runtime.env (mode 600).
# Generate the secret with `openssl rand -hex 32`, or the
# RandomNumberGenerator API on Windows. Minimum 24 URL-safe characters.
MCP_PATH_SECRET=replace-with-a-random-secret

# The only directory the file and shell tools may touch.
CODE_ROOT=/home/you/projects
HOST=127.0.0.1
PORT=8787
